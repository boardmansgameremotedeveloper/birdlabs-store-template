      "default": "A short paragraph introducing the store. Replace this with your own copy."
    },
    {
      "type": "text",
      "id": "pills",
      "label": "Attribute pills",
      "info": "Comma-separated. Leave blank to hide.",
      "default": "Free shipping, Easy returns, Made to order"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For one-page navigation, e.g. \"home\" makes this section reachable at /#home. Leave blank for an automatic ID.",
      "default": "home"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
