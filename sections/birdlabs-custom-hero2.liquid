      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Your headline"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "Here"
    },
    {
      "type": "textarea",
      "id": "subtext",
