{% comment %}
  sections/birdlabs-custom-hero3.liquid

  Birdlabs Custom Hero 3 — split hero: copy on the left, a rotating image on the right.
  Modelled on buyflorabella.com's homepage hero ("Wake Up Your Soil Today" beside a
  product photograph).

  Why a custom section rather than a stock Horizon one: Horizon can produce a two-column
  hero, but not one whose image side CROSS-FADES through several photographs while the copy
  stays put. That rotation is the thing being asked for, and it is what makes the panel feel
  alive without a video.

  Notes on the build:
  - Images are BLOCKS, so the merchant adds, removes and reorders them. One image simply
    holds still; the rotation only starts when there are two or more.
  - Rotation is CSS-driven with per-slide animation-delay, so it costs no JavaScript and
    cannot fall out of sync with itself.
  - Colours come from the theme palette (--bl-*), so the section follows the light/dark
    toggle. Any colour setting left blank inherits; set one and it overrides.
  - Honours prefers-reduced-motion by holding the first image rather than cross-fading.
  - The copy side takes an eyebrow, a two-tone heading, body text, two buttons and a row of
    trust points — the same anatomy as the source, but every string is a setting.
{% endcomment %}

{%- liquid
  assign anchor = section.settings.anchor_id | strip | handleize
  if anchor == blank
    assign anchor = 'birdlabs-hero3-' | append: section.id
  endif

  assign slides = section.blocks | where: 'type', 'image'
  assign slide_count = slides.size
  assign cycle = section.settings.rotate_seconds | times: slide_count
-%}

<section
  id="{{ anchor }}"
  class="birdlabs-hero3 birdlabs-hero3--media-{{ section.settings.media_position }}"
  data-section-id="{{ section.id }}"
  style="
    {%- if section.settings.bg_color != blank %}--h3-bg: {{ section.settings.bg_color }};{% endif -%}
    {%- if section.settings.text_color != blank %}--h3-fg: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.accent_color != blank %}--h3-accent: {{ section.settings.accent_color }};{% endif -%}
    --h3-cycle: {{ cycle }}s;
    --h3-radius: {{ section.settings.image_radius }}px;
  "
>
  <div class="birdlabs-hero3__inner">
    <div class="birdlabs-hero3__copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="birdlabs-hero3__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="birdlabs-hero3__heading">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank -%}
            <span class="birdlabs-hero3__heading-accent">
              {{- section.settings.heading_accent | escape -}}
            </span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="birdlabs-hero3__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <div class="birdlabs-hero3__note">{{ section.settings.note | escape }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="birdlabs-hero3__ctas">
          {%- if section.settings.cta_label != blank -%}
            <a class="birdlabs-hero3__cta" href="{{ section.settings.cta_url | default: '#' }}">
              {{- section.settings.cta_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="birdlabs-hero3__cta birdlabs-hero3__cta--ghost" href="{{ section.settings.cta2_url | default: '#' }}">
              {{- section.settings.cta2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- assign points = section.blocks | where: 'type', 'point' -%}
      {%- if points.size > 0 -%}
        <ul class="birdlabs-hero3__points">
          {%- for block in points -%}
            <li class="birdlabs-hero3__point" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span aria-hidden="true">{{ block.settings.icon | escape }}</span>
              {%- endif -%}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="birdlabs-hero3__media">
      {%- if slide_count > 0 -%}
        <div class="birdlabs-hero3__stage{% if slide_count > 1 %} is-rotating{% endif %}">
          {%- for block in slides -%}
            {%- comment -%}
              Each slide carries its own delay, one step apart, so the cross-fade is driven
              entirely by CSS — nothing to keep in sync and no JavaScript to load.
            {%- endcomment -%}
            <div
              class="birdlabs-hero3__slide"
              style="animation-delay: -{{ forloop.index0 | times: section.settings.rotate_seconds }}s;"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'birdlabs-hero3__img',
                    widths: '400, 700, 1000, 1400',
                    sizes: '(min-width: 990px) 45vw, 92vw',
                    loading: 'lazy',
                    alt: block.settings.alt
                }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .birdlabs-hero3 {
    padding: 72px 24px;
    background: var(--h3-bg, var(--bl-bg));
    color: var(--h3-fg, var(--bl-fg));
  }

  .birdlabs-hero3__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1240px;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    .birdlabs-hero3__inner { grid-template-columns: 1fr 1fr; gap: 64px; }

    /* Media on the left is a column-order swap, not a second layout. */
    .birdlabs-hero3--media-left .birdlabs-hero3__copy { order: 2; }
    .birdlabs-hero3--media-left .birdlabs-hero3__media { order: 1; }
  }

  .birdlabs-hero3__eyebrow {
    margin-bottom: 12px;
    color: var(--h3-accent, var(--bl-accent));
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .birdlabs-hero3__heading {
    margin: 0 0 18px;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .birdlabs-hero3__heading-accent {
    display: block;
    color: var(--h3-accent, var(--bl-accent));
  }

  .birdlabs-hero3__body {
    max-width: 46ch;
    margin: 0 0 20px;
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .birdlabs-hero3__note {
    max-width: 46ch;
    margin: 0 0 24px;
    padding: 14px 18px;
    border: 1px solid var(--bl-border);
    border-radius: 12px;
    background: var(--bl-surface);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .birdlabs-hero3__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .birdlabs-hero3__cta {
    display: inline-block;
    padding: 14px 34px;
    border: 2px solid transparent;
    border-radius: 40px;
    background: var(--h3-accent, var(--bl-accent));
    color: var(--bl-on-accent);
    font-family: var(--font-heading--family);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .birdlabs-hero3__cta--ghost {
    border-color: currentColor;
    background: transparent;
    color: var(--h3-fg, var(--bl-fg));
  }

  .birdlabs-hero3__points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .birdlabs-hero3__point {
    display: flex;
    gap: 8px;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .birdlabs-hero3__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--h3-radius, 20px);
    background: var(--bl-surface);
    box-shadow: 0 24px 60px rgb(0 0 0 / 18%);
  }

  .birdlabs-hero3__slide {
    position: absolute;
    inset: 0;
  }

  .birdlabs-hero3__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * Cross-fade. Each slide is visible for its share of the cycle and fades at the seams.
   * With a single image `.is-rotating` is absent, so nothing animates and it simply shows.
   */
  @keyframes birdlabs-hero3-fade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    30% { opacity: 1; }
    36% { opacity: 0; }
    100% { opacity: 0; }
  }

  .birdlabs-hero3__stage.is-rotating .birdlabs-hero3__slide {
    opacity: 0;
    animation: birdlabs-hero3-fade var(--h3-cycle, 18s) linear infinite;
  }

  @media (max-width: 989px) {
    .birdlabs-hero3 { padding: 56px 20px; }
    .birdlabs-hero3__stage { aspect-ratio: 3 / 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-hero3__stage.is-rotating .birdlabs-hero3__slide { animation: none; opacity: 0; }
    /* Hold the first image rather than cycling. */
    .birdlabs-hero3__stage.is-rotating .birdlabs-hero3__slide:first-child { opacity: 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Birdlabs Custom Hero 3",
  "tag": "section",
  "class": "birdlabs-hero3-wrapper",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "image",
      "name": "Rotating image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "point",
      "name": "Trust point",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "info": "An emoji. Optional." },
        { "type": "text", "id": "text", "label": "Text", "default": "Made for home growers" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wake up your soil" },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading second line",
      "info": "Shown underneath in the accent colour.",
      "default": "today"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "An organic, ancient mineral deposit — quarried, composted and refined so the natural biology in your soil comes back to life."
    },
    { "type": "textarea", "id": "note", "label": "Highlight panel", "info": "Optional boxed note under the body." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image side",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Seconds per image",
      "info": "Only applies when two or more images are added.",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For one-page navigation — \"home\" makes this reachable at /#home.",
      "default": "home"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "info": "Leave blank to follow the store theme (light/dark)." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave blank to follow the store theme (light/dark)." },
    { "type": "color", "id": "accent_color", "label": "Accent", "info": "Leave blank to follow the store theme (light/dark)." }
  ],
  "presets": [
    {
      "name": "Birdlabs Custom Hero 3",
      "blocks": [
        { "type": "image", "settings": { "alt": "Product in use" } },
        { "type": "image", "settings": { "alt": "Product detail" } },
        { "type": "image", "settings": { "alt": "In the garden" } }
      ]
    }
  ]
}
{% endschema %}
