{% comment %}
  sections/birdlabs-products-1.liquid

  Birdlabs Products — filterable product grid for a one-page storefront.
  Ported from FLTHQ's sections/flt-products-1.liquid (Horizon 3.4.0) to Horizon 4.1.4.

  Filter buttons are built from the store's collections, exactly as FLTHQ does.
  Category = Shopify collection. Adding a collection adds a button; no code change.

  THE ONE DELIBERATE DIVERGENCE — each product is rendered ONCE.

  FLTHQ renders a separate grid per collection, so a product in three collections is
  emitted three times and filtering swaps which grid is visible. That is invisible at
  6 products and expensive at 100. Here every product is rendered once carrying
  data-collections="handle-a handle-b", and filtering toggles a class on the cards.
  Same behaviour, one copy of each card.

  (FLTHQ has a commented-out block attempting this, marked "not working". Its bug was
  sourcing from a single `collection` setting that was never configured, so the grid
  fell through to its empty state. This version sources from collections.all.)

  SCALING LIMIT, stated plainly: Liquid caps an unpaginated loop at 50 products, and
  client-side filtering needs every card in the DOM. This section is right for roughly
  1-50 products. A larger catalog needs a different section that fetches on demand via
  the Section Rendering API - see 0003_plan.md addendum A3.
{% endcomment %}

{%- liquid
  assign anchor = section.settings.anchor_id | strip | handleize
  if anchor == blank
    assign anchor = 'birdlabs-products-' | append: section.id
  endif
  assign product_limit = section.settings.products_shown
-%}

<section id="{{ anchor }}" class="birdlabs-products" data-section-id="{{ section.id }}">
  <div class="birdlabs-products__inner">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="birdlabs-reveal birdlabs-products__heading-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <div class="birdlabs-products__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="birdlabs-products__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_filters -%}
      <div class="birdlabs-reveal birdlabs-products__filters" role="group" aria-label="Filter products by category">
        <button
          class="birdlabs-products__filter is-active"
          type="button"
          data-filter="all"
          aria-pressed="true"
        >
          {{ section.settings.all_label | escape }}
        </button>

        {%- for collection in collections -%}
          {%- if collection.products_count > 0
            and collection.handle != 'frontpage'
            and collection.handle != 'all'
          -%}
            <button
              class="birdlabs-products__filter"
              type="button"
              data-filter="{{ collection.handle }}"
              aria-pressed="false"
            >
              {{ collection.title | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="birdlabs-products__grid" data-product-grid>
      {%- for product in collections.all.products limit: product_limit -%}
        <div class="birdlabs-reveal birdlabs-products__cell" style="transition-delay: {{ forloop.index0 | times: 0.06 }}s">
          {% render 'birdlabs-product-card', product: product %}
        </div>
      {%- else -%}
        <p class="birdlabs-products__empty">
          No products yet. Add products to this store and they appear here automatically.
        </p>
      {%- endfor -%}
    </div>

    <p class="birdlabs-products__no-results" hidden>Nothing in this category yet.</p>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"].birdlabs-products');
    if (!root) return;
    if (root.dataset.birdlabsInit === 'true') return;
    root.dataset.birdlabsInit = 'true';

    var filters = root.querySelectorAll('.birdlabs-products__filter');
    var cells = root.querySelectorAll('.birdlabs-products__cell');
    var noResults = root.querySelector('.birdlabs-products__no-results');

    /* ── Category filter ────────────────────────────────────────────────────
       Cards carry their collection handles; filtering toggles a class rather
       than swapping duplicate grids. */
    filters.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var wanted = btn.dataset.filter;
        var shown = 0;

        filters.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

        cells.forEach(function (cell) {
          var card = cell.querySelector('.birdlabs-product-card');
          var handles = card ? (card.dataset.collections || '').split(/\s+/) : [];
          var match = wanted === 'all' || handles.indexOf(wanted) !== -1;
          cell.classList.toggle('is-hidden', !match);
          if (match) shown++;
        });

        if (noResults) noResults.hidden = shown !== 0;
      });
    });

    /* Scroll reveal is handled globally by assets/birdlabs-reveal.js. */

    /* ── Add to cart ────────────────────────────────────────────────────────
       Posts to /cart/add.js so the page never navigates, then tells Horizon's
       stock cart drawer to update. The drawer listens for this event at
       assets/cart-drawer.js:33 and reads `action` off it. */
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.birdlabs-product-card__btn');
      if (!btn || btn.disabled) return;

      var variantId = btn.dataset.variantId;
      if (!variantId) return;

      e.preventDefault();
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding…';

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
      })
        .then(function (r) {
          if (!r.ok) throw new Error('add failed');
          return r.json();
        })
        .then(function () {
          var evt = new CustomEvent('shopify:cart:lines-update', { bubbles: true, cancelable: false });
          evt.action = 'add';
          document.dispatchEvent(evt);
          btn.textContent = 'Added';
          setTimeout(function () { btn.textContent = original; btn.disabled = false; }, 1800);
        })
        .catch(function () {
          btn.textContent = 'Try again';
          btn.disabled = false;
          setTimeout(function () { btn.textContent = original; }, 2000);
        });
    });
  })();
</script>

<script src="{{ 'birdlabs-anchor-scroll.js' | asset_url }}" defer></script>
<script src="{{ 'birdlabs-reveal.js' | asset_url }}" defer></script>

{% stylesheet %}
  .birdlabs-products {
    position: relative;
    overflow: hidden;
    padding: 120px 40px;
  }

  .birdlabs-products__inner {
    position: relative;
    z-index: 1;
    max-width: 1300px;
    margin: 0 auto;
  }

  .birdlabs-products__heading-wrap {
    margin-bottom: 56px;
    text-align: center;
  }

  .birdlabs-products__eyebrow {
    margin-bottom: 12px;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .birdlabs-products__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .birdlabs-products__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
  }

  .birdlabs-products__filter {
    padding: 10px 30px;
    border: 1px solid rgb(0 0 0 / 12%);
    border-radius: 30px;
    background: rgb(0 0 0 / 3%);
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .birdlabs-products__filter:hover { opacity: 1; }

  .birdlabs-products__filter.is-active {
    border-color: transparent;
    background: var(--birdlabs-accent, #0b2545);
    color: #fff;
    opacity: 1;
  }

  .birdlabs-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }

  .birdlabs-products__cell.is-hidden { display: none; }

  .birdlabs-products__empty,
  .birdlabs-products__no-results {
    grid-column: 1 / -1;
    font-family: var(--font-body--family);
    text-align: center;
    opacity: 0.6;
  }

  /* Scroll reveal */
  .birdlabs-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .birdlabs-reveal.is-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Product card */
  .birdlabs-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 12px;
    background: rgb(255 255 255 / 60%);
  }

  .birdlabs-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 6px 14px;
    border-radius: 20px;
    background: var(--birdlabs-accent, #0b2545);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .birdlabs-product-card__image-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: rgb(0 0 0 / 4%);
  }

  .birdlabs-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .birdlabs-product-card:hover .birdlabs-product-card__img { transform: scale(1.04); }

  .birdlabs-product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }

  .birdlabs-product-card__name {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .birdlabs-product-card__name a {
    color: inherit;
    text-decoration: none;
  }

  .birdlabs-product-card__desc,
  .birdlabs-product-card__tagline {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  .birdlabs-product-card__tagline {
    font-style: italic;
    opacity: 0.55;
  }

  .birdlabs-product-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
  }

  .birdlabs-product-card__price {
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
  }

  .birdlabs-product-card__price-was {
    margin-right: 6px;
    font-size: 0.875rem;
    opacity: 0.5;
  }

  .birdlabs-product-card__btn {
    padding: 10px 22px;
    border: none;
    border-radius: 30px;
    background: var(--birdlabs-accent, #0b2545);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .birdlabs-product-card__btn[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .birdlabs-products { padding: 80px 20px; }
    .birdlabs-products__grid { grid-template-columns: 1fr; }

    /* Filter chips scroll horizontally rather than wrapping into a tall block. */
    .birdlabs-products__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 6px;
    }

    .birdlabs-products__filter { flex: 0 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .birdlabs-product-card__img { transition: none; }
    .birdlabs-product-card:hover .birdlabs-product-card__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Birdlabs Products",
  "tag": "section",
  "class": "birdlabs-products-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our products"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "For one-page navigation — \"products\" makes this reachable at /#products.",
      "default": "products"
    },
    {
      "type": "header",
      "content": "Category filters"
    },
    {
      "type": "paragraph",
      "content": "A button is generated for every collection that contains at least one product. Create collections in the store admin to add categories — no theme change needed."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filter buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Label for the \"all\" button",
      "default": "All products"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_shown",
      "label": "Maximum products shown",
      "min": 4,
      "max": 50,
      "step": 2,
      "default": 24,
      "info": "Liquid caps an unpaginated grid at 50. For a larger catalog this section needs a paginated variant."
    }
  ],
  "presets": [
    {
      "name": "Birdlabs Products",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
