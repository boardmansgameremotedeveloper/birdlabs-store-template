{% comment %}
  snippets/birdlabs-drift-particles.liquid

  Drifting geometric particles for a hero background. Ported from FLTHQ's
  snippets/animated-flowers.liquid.

  CORRECTION: I originally dropped this from the hero port as "client artwork". It is not.
  It is a procedurally drawn flower-of-life motif — seven overlapping circles in plain white
  stroke, generated in Liquid, with no brand content whatsoever. Reads as a snowflake or a
  drifting mote depending on the palette. It belongs in the template.

  Usage:
    {% render 'birdlabs-drift-particles',
        count: 18, size: 48, shape: 'flower', color: '#ffffff', opacity: 70,
        min_duration: 10, glow: '#87ceeb' %}

  The CSS lives in the CONSUMING SECTION's {% stylesheet %} block, not here — Horizon
  aggregates and caches those, whereas a <style> tag in a snippet is re-emitted on every
  render. Any section rendering this must include the `.birdlabs-drift*` rules; copy them
  from sections/birdlabs-custom-hero2.liquid.

  Positions and timings are derived from the loop index rather than randomised, so the
  layout is identical on every render — no server/client mismatch, no layout shift.
{% endcomment %}

{%- liquid
  assign p_count = count | default: 18
  assign p_size = size | default: 48
  assign p_shape = shape | default: 'flower'
  assign p_color = color | default: '#ffffff'
  assign p_opacity = opacity | default: 70
  assign p_min = min_duration | default: 10
  assign p_glow = glow | default: '#87ceeb'
-%}

<div
  class="birdlabs-drift"
  aria-hidden="true"
  style="
    --bd-size: {{ p_size }}px;
    --bd-color: {{ p_color }};
    --bd-opacity: {{ p_opacity | divided_by: 100.0 }};
    --bd-glow: {{ p_glow }};
  "
>
  {%- for i in (1..p_count) -%}
    {%- liquid
      assign top_pct = i | times: 7 | modulo: 80 | plus: 5
      assign dur = i | times: 7 | modulo: 12 | plus: p_min
      assign del = i | times: 11 | modulo: dur
      assign scale = i | modulo: 3 | times: 15 | plus: 70
    -%}
    <span
      class="birdlabs-drift__item"
      style="
        top: {{ top_pct }}%;
        animation-duration: {{ dur }}s;
        animation-delay: -{{ del }}s;
        transform: scale({{ scale | divided_by: 100.0 }});
      "
    >
      <svg viewBox="0 0 500 500" width="{{ p_size }}" height="{{ p_size }}" focusable="false">
        {%- if p_shape == 'snowflake' -%}
          <g transform="translate(250,250)" stroke="{{ p_color }}" stroke-width="14" fill="none" stroke-linecap="round">
            {%- for arm in (0..5) -%}
              {%- assign deg = arm | times: 60 -%}
              <g transform="rotate({{ deg }})">
                <line x1="0" y1="0" x2="0" y2="-200"/>
                <line x1="0" y1="-120" x2="-45" y2="-165"/>
                <line x1="0" y1="-120" x2="45" y2="-165"/>
                <line x1="0" y1="-70" x2="-32" y2="-102"/>
                <line x1="0" y1="-70" x2="32" y2="-102"/>
              </g>
            {%- endfor -%}
          </g>
        {%- elsif p_shape == 'hexagon' -%}
          <g transform="translate(250,250)" stroke="{{ p_color }}" stroke-width="16" fill="none">
            <polygon points="0,-190 165,-95 165,95 0,190 -165,95 -165,-95"/>
          </g>
        {%- else -%}
          {%- comment -%} flower of life — the FLTHQ original {%- endcomment -%}
          <g transform="translate(250,250)" stroke="{{ p_color }}" stroke-width="3" fill="none">
            <circle r="50"/>
            <circle cx="50" cy="0" r="50"/>
            <circle cx="-50" cy="0" r="50"/>
            <circle cx="25" cy="43.3" r="50"/>
            <circle cx="-25" cy="43.3" r="50"/>
            <circle cx="25" cy="-43.3" r="50"/>
            <circle cx="-25" cy="-43.3" r="50"/>
          </g>
        {%- endif -%}
      </svg>
    </span>
  {%- endfor -%}
</div>
