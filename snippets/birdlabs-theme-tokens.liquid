{% comment %}
  snippets/birdlabs-theme-tokens.liquid

  Binds the Birdlabs palette to SHOPIFY'S NATIVE COLOUR PALETTE.

  THE POINT OF THIS FILE, restated after a refactor:

  Light theme is now 100% Shopify-native. Every --bl-* token below is an ALIAS of a variable
  Horizon already computes from `settings.color_palette` — the standard palette any merchant
  edits under Theme settings -> Colors. Nothing here invents a colour for the light theme, so
  changing the palette in the Shopify UI changes every Birdlabs section with it. There is no
  parallel light palette to keep in sync, because there is no parallel light palette.

  Dark theme cannot work the same way, and this is a Shopify limitation rather than a
  shortcut: **Shopify has no native dark palette.** `settings.color_palette` is a single set
  of colours shipped to every visitor. So the dark theme is a small set of theme settings that
  OVERRIDE Horizon's own --color-* variables. The --bl-* aliases below are unchanged, so every
  section follows automatically — one indirection, not a second system.

  Net effect:
    light  -> edit Theme settings -> Colors (native, 16-colour palette)
    dark   -> edit Theme settings -> Birdlabs dark theme (8 settings, because Shopify has none)
{% endcomment %}

{%- liquid
  # Dark overrides. Defaults are a purple / yellow / pink scheme rather than purple-on-black.
  assign d_bg = settings.bl_dark_bg | default: '#1a0b2e'
  assign d_surface = settings.bl_dark_surface | default: '#2a1546'
  assign d_fg = settings.bl_dark_fg | default: '#f7edff'
  assign d_muted = settings.bl_dark_muted | default: '#bda6d6'
  assign d_border = settings.bl_dark_border | default: '#3f2766'
  assign d_accent = settings.bl_dark_accent | default: '#ffd93d'
  assign d_on_accent = settings.bl_dark_on_accent | default: '#2a1546'
  assign d_accent_2 = settings.bl_dark_accent_2 | default: '#ff5fa2'
-%}

<style>
  /*
   * LIGHT — pure aliases. Every value traces back to settings.color_palette via Horizon's
   * own snippets/color-palette.liquid. Edit the palette in Shopify and this follows.
   */
  :root {
    --bl-bg: var(--color-background);
    --bl-fg: var(--color-foreground);
    --bl-muted: var(--color-foreground-muted);
    --bl-border: var(--color-border);
    --bl-accent: var(--color-primary-button-background);
    --bl-on-accent: var(--color-primary-button-text);
    --bl-accent-2: var(--color-primary-button-background);
    /* No native "surface" token exists, so derive one from the two that do rather than
       inventing a colour that the palette cannot reach. */
    --bl-surface: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
    --bl-band: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background));
    --birdlabs-accent: var(--bl-accent);
  }

  /*
   * DARK — overrides Horizon's own tokens, so both stock Horizon sections and the --bl-*
   * aliases above follow without either knowing about the other.
   */
  [data-birdlabs-theme='dark'] {
    --color-background: {{ d_bg }};
    --color-background-rgb: {{ d_bg.rgb }};
    --color-foreground: {{ d_fg }};
    --color-foreground-rgb: {{ d_fg.rgb }};
    --color-foreground-muted: {{ d_muted }};
    --color-foreground-subdued: {{ d_muted }};
    --color-border: {{ d_border }};
    --color-border-rgb: {{ d_border.rgb }};
    --color-input-background: {{ d_surface }};
    --color-input-border: {{ d_border }};
    --color-input-text: {{ d_fg }};
    --color-input-text-rgb: {{ d_fg.rgb }};
    --color-primary-button-background: {{ d_accent }};
    --color-primary-button-text: {{ d_on_accent }};
    --color-primary-button-border: {{ d_accent }};

    --bl-surface: {{ d_surface }};
    --bl-band: {{ d_surface }};
    --bl-accent-2: {{ d_accent_2 }};
    color-scheme: dark;
  }

  /* Product photography is shot on light backgrounds; a small knock-down stops it glaring
     against a dark page. SVG logos are left alone. */
  [data-birdlabs-theme='dark'] img:not([src$='.svg']) { filter: brightness(0.94); }

  /*
   * ── Background textures ───────────────────────────────────────────────────────────
   *
   * buyflorabella gets its "light but not flat" feel from a very subtle off-white vertical
   * gradient (linear-gradient(#fafaf9, #f0f0ee)) with a low-opacity pattern layered over it.
   * Reproduced here in tokens rather than fixed greys, so the same classes work on the dark
   * theme instead of only the light one.
   *
   * Deliberately CSS-only. A tiling noise PNG would be heavier, would need uploading to every
   * clone's Files, and could not follow the palette.
   *
   * Usage: add .birdlabs-tex plus one variant to any section.
   */
  .birdlabs-tex {
    position: relative;
    /* The base wash: barely-there vertical shift, the same trick as gradient-offwhite. */
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bl-fg) 1%, var(--bl-bg)),
      color-mix(in srgb, var(--bl-fg) 4%, var(--bl-bg))
    );
  }

  /* The pattern rides on a pseudo-element so it never fights a section's own background,
     and pointer-events stay with the content underneath. */
  .birdlabs-tex::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .birdlabs-tex > * { position: relative; z-index: 1; }

  /* Fine diagonal weave — reads as paper stock at arm's length. */
  .birdlabs-tex--weave::before {
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--bl-fg) 3%, transparent) 0 1px,
      transparent 1px 7px
    );
  }

  /* Sparse dot field — quieter than the weave, good behind media. */
  .birdlabs-tex--dots::before {
    background-image: radial-gradient(
      color-mix(in srgb, var(--bl-fg) 7%, transparent) 1px,
      transparent 1px
    );
    background-size: 18px 18px;
  }

  /* Soft corner vignettes: shape without the coloured "splotch" look of a tinted blur. */
  .birdlabs-tex--soft::before {
    background-image:
      radial-gradient(60% 55% at 15% 10%, color-mix(in srgb, var(--bl-fg) 5%, transparent), transparent 70%),
      radial-gradient(55% 50% at 88% 92%, color-mix(in srgb, var(--bl-fg) 4%, transparent), transparent 70%);
  }

  /*
   * ── Scroll reveal ─────────────────────────────────────────────────────────────────
   *
   * Lives here, not in a section, because FIVE sections use `.birdlabs-reveal` while only
   * one used to define it. Shopify aggregates every section stylesheet theme-wide, so that
   * worked — right up until someone deleted the section that happened to own the rules, at
   * which point four unrelated sections would have gone blank with nothing to point at.
   *
   * `.birdlabs-js` is added by assets/birdlabs-reveal.js the moment it executes, so the
   * hidden state only ever applies when something is present to undo it. Without JS the
   * content simply shows: a missing animation, not a silent content outage.
   */
  .birdlabs-js .birdlabs-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .birdlabs-reveal.is-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-js .birdlabs-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .birdlabs-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .birdlabs-theme-toggle:hover { background: color-mix(in srgb, currentColor 14%, transparent); }
  .birdlabs-theme-toggle svg { width: 18px; height: 18px; }
  .birdlabs-theme-toggle__moon { display: none; }
  [data-birdlabs-theme='dark'] .birdlabs-theme-toggle__sun { display: none; }
  [data-birdlabs-theme='dark'] .birdlabs-theme-toggle__moon { display: block; }
</style>

<script>
  /*
   * Runs before first paint so a returning visitor never sees the wrong theme flash.
   * Storage: localStorage key "birdlabs-theme", value "light" or "dark".
   * Light is the default. With nothing stored we follow prefers-color-scheme, and keep
   * following it until the visitor chooses for themselves.
   */
  (function () {
    try {
      var saved = localStorage.getItem('birdlabs-theme');
      var dark = saved
        ? saved === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-birdlabs-theme', dark ? 'dark' : 'light');
    } catch (e) {
      document.documentElement.setAttribute('data-birdlabs-theme', 'light');
    }
  })();
</script>
